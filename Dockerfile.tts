FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 HF_HOME=/home/tts/.cache/huggingface
RUN apt-get update && apt-get install -y --no-install-recommends espeak-ng libespeak-ng1 \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /service
COPY requirements-kokoro.txt requirements-tts-service.txt ./
RUN pip install --no-cache-dir -r requirements-tts-service.txt
RUN useradd --create-home tts
COPY kokoro_tts.py tts_service.py ./
USER tts
EXPOSE 8000
# One model per process. Do not multiply workers on a small CPU host.
CMD ["python", "-m", "uvicorn", "tts_service:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--no-access-log"]
